server:
  port: 8080

spring:
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/restaurant_db?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    # TODO: 改成你自己的 MySQL 密码（推荐用环境变量 DB_PASSWORD 注入）
    password: ${DB_PASSWORD}
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai

# MyBatis-Plus 配置
mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.restaurant.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# JWT 配置
jwt:
  # TODO: 改成随机字符串，并通过环境变量 JWT_SECRET 注入（与 JwtUtil.java 保持一致）
  secret: ${JWT_SECRET}
  expiration: 86400000  # 24 小时 (毫秒)

# AI API 配置 (两组独立密钥)
ai:
  assistant:                          # AI 点餐助手 (页面)
    url: https://api.deepseek.com/v1/chat/completions
    # TODO: 填入你的 DeepSeek API Key（推荐用环境变量 DEEPSEEK_ASSISTANT_KEY 注入）
    key: ${DEEPSEEK_ASSISTANT_KEY}
    model: deepseek-chat
    timeout: 30000
  customer:                           # AI 智能客服 (气泡)
    url: https://api.deepseek.com/v1/chat/completions
    # TODO: 填入你的 DeepSeek API Key（推荐用环境变量 DEEPSEEK_CUSTOMER_KEY 注入）
    key: ${DEEPSEEK_CUSTOMER_KEY}
    model: deepseek-chat
    timeout: 30000

# 文件上传配置
file:
  upload:
    path: ./uploads/
    max-size: 10MB
